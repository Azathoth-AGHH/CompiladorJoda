<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- DATOS DEL PROYECTO -->
    <groupId>compilador</groupId>
    <artifactId>compilador-joda</artifactId>
    <version>2.2</version>
    <packaging>jar</packaging>

    <name>Compilador JODA</name>
    <description>Compilador JODA con JavaFX, RichTextFX y PDFBox</description>

    <!-- PROPIEDADES -->
    <properties>

        <!-- Java -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX -->
        <javafx.version>17.0.2</javafx.version>

        <!--
            CAMBIO: La clase principal ahora es Launcher, no App directamente.
            Esto es necesario para que el fat JAR arranque correctamente,
            ya que la JVM bloquea el inicio si la clase principal extiende
            javafx.application.Application dentro de un JAR con modulos nativos.
        -->
        <main.class>vista_grafica.Launcher</main.class>

    </properties>

    <!-- DEPENDENCIAS -->
    <dependencies>

        <!-- ========================= -->
        <!-- JAVAFX (con binarios nativos de Windows incluidos en el JAR) -->
        <!--
            CAMBIO: Se agrego classifier>win</classifier> a cada dependencia de JavaFX.
            Esto hace que Maven descargue los binarios nativos (.dll) de Windows
            y los empaque dentro del fat JAR, permitiendo el doble clic sin
            necesitar tener JavaFX instalado por separado en el sistema.
        -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <!-- ========================= -->
        <!-- RICHTEXTFX -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.3</version>
        </dependency>

        <dependency>
            <groupId>org.reactfx</groupId>
            <artifactId>reactfx</artifactId>
            <version>2.0-M5</version>
        </dependency>

        <dependency>
            <groupId>org.fxmisc.flowless</groupId>
            <artifactId>flowless</artifactId>
            <version>0.6.10</version>
        </dependency>

        <dependency>
            <groupId>org.fxmisc.undo</groupId>
            <artifactId>undofx</artifactId>
            <version>2.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.fxmisc.wellbehaved</groupId>
            <artifactId>wellbehavedfx</artifactId>
            <version>0.3.3</version>
        </dependency>

        <!-- ========================= -->
        <!-- PDFBOX -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- ========================= -->
        <!-- LOGGING -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.12</version>
        </dependency>

    </dependencies>

    <!-- BUILD -->
    <build>

        <plugins>

            <!-- ========================= -->
            <!-- COMPILADOR JAVA -->
            <!-- ========================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>

                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- ========================= -->
            <!-- JAVAFX (solo para mvn javafx:run en desarrollo) -->
            <!-- ========================= -->

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>

                    <!-- En desarrollo se sigue usando App directamente -->
                    <mainClass>vista_grafica.App</mainClass>

                    <options>

                        <option>--add-opens</option>
                        <option>java.base/java.lang=ALL-UNNAMED</option>

                        <option>--add-opens</option>
                        <option>java.base/java.lang.reflect=ALL-UNNAMED</option>

                        <option>--add-opens</option>
                        <option>java.base/java.util=ALL-UNNAMED</option>

                    </options>

                </configuration>
            </plugin>

            <!-- ========================= -->
            <!-- FAT JAR EJECUTABLE (maven-shade-plugin) -->
            <!--
                CAMBIO: La mainClass del ManifestResourceTransformer ahora
                apunta a vista_grafica.Launcher en lugar de vista_grafica.App.
                Esto es el truco clave para que el JAR arranque con doble clic:
                Launcher llama a App.main() sin extender Application,
                evitando el bloqueo de la JVM al detectar modulos JavaFX nativos.
            -->
            <!-- ========================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>

                <executions>

                    <execution>

                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <transformers>

                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <!-- CAMBIO: Launcher en lugar de App -->
                                    <mainClass>${main.class}</mainClass>
                                </transformer>

                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                            </transformers>

                            <filters>

                                <filter>

                                    <artifact>*:*</artifact>

                                    <excludes>

                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Excluir archivos de modulos de JavaFX que rompen el shade -->
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>

                                    </excludes>

                                </filter>

                            </filters>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

        <!-- RECURSOS -->
        <resources>

            <resource>

                <directory>src/main/resources</directory>

                <includes>

                    <include>**/*.fxml</include>
                    <include>**/*.css</include>
                    <include>**/*.png</include>
                    <include>**/*.jpg</include>
                    <include>**/*.gif</include>

                </includes>

            </resource>

        </resources>

    </build>

</project>